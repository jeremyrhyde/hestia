# Hestia environment overrides. Copy to `.env` (which is gitignored) and edit.
# Both the FastAPI server (config.py) and the kiosk launcher
# (web/kiosk/start-kiosk.sh) read this file.

# --- Kiosk: which server the touchscreen Chromium points at ---------------
# By default the kiosk opens the server running on the SAME Pi
# (http://localhost:8000/ui/). To point a touchscreen station at a central
# server elsewhere on the network, set its IP here — the kiosk will open
# http://<SERVER_IP_ADDRESS>:8000/ui/ instead. Leave unset for local.
#SERVER_IP_ADDRESS=192.168.1.50

# Full URL override for the kiosk (wins over SERVER_IP_ADDRESS if set).
# Use only if you need a non-standard host/port/path.
#HESTIA_UI_URL=http://192.168.1.50:8000/ui/

# --- Server (FastAPI) settings — all optional, defaults shown -------------
#HOST=0.0.0.0
#PORT=8000
#DB_PATH=./home-auto.db
#LOG_LEVEL=info
#WEB_DIR=./web
#DEVICES_CONFIG_PATH=./devices.yaml
