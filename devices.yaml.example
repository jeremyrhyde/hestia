# devices.yaml — registered hardware devices
#
# Copy this file to `devices.yaml` and fill in the values for the hardware
# you actually have. The Phase 3 API entry point reads this file at startup,
# instantiates one driver per entry, and registers it under `id`.
#
# The shape is validated by `schemas.DevicesConfig` (see `schemas/config.py`).
# Each entry must specify:
#
#   id        Stable slug used in `/devices/{id}/...` URLs.
#   name      Human-readable label shown in the UI.
#   driver    One of: "relay", "kasa", "spotify".
#   params    Driver-specific keyword arguments passed to the driver
#             constructor.

devices:
  # ---------------------------------------------------------------------
  # GPIO relay wired to the Pi's pin header.
  # ---------------------------------------------------------------------
  - id: relay-desk
    name: Desk lamp
    driver: relay
    params:
      pin: 17           # BCM pin number wired to the relay's signal line
      active_high: true # See note below.

  # Active-high vs active-low — most common config mistake:
  #
  # If `turn_on` doesn't make the relay click but `turn_off` does (or
  # vice-versa), the board is the opposite polarity from what you set.
  # Most cheap blue/black optoisolated relay boards (1/2/4 channel,
  # with a JD-VCC jumper) are ACTIVE-LOW: pulling the signal pin LOW
  # energizes the relay. For those, set `active_high: false`.
  #
  # Quick test on the Pi (replace 17 with your pin):
  #   sudo python3 -c "import lgpio,time; h=lgpio.gpiochip_open(0); \
  #     lgpio.gpio_write(h, 17, 0); time.sleep(2); \
  #     lgpio.gpio_write(h, 17, 1); time.sleep(2); lgpio.gpiochip_close(h)"
  # If the click happens on `0`, set active_high: false.
  # If the click happens on `1`, set active_high: true.

  # ---------------------------------------------------------------------
  # Kasa smart plug on the LAN.
  # ---------------------------------------------------------------------
  - id: kasa-living-room
    name: Living room plug
    driver: kasa
    params:
      host: 192.168.1.42  # IP or hostname of the Kasa device
      kind: plug          # "plug" or "bulb"; bulbs gain the dimmer capability

  # ---------------------------------------------------------------------
  # Tandem fixture — multiple Kasa devices controlled as one.
  #
  # Common case: a fixture with two bulbs that should always behave as a
  # single light from the user's perspective. Use a list for `host`:
  #
  #     params:
  #       host: [192.168.1.6, 192.168.1.7]
  #       kind: bulb
  #
  # Behavior:
  # - Every action (turn_on/off/toggle/set_brightness) fans out to all
  #   members concurrently.
  # - Power state is reported as `any(member is on)` — tapping the toggle
  #   feels responsive even if members have drifted out of sync.
  # - Brightness is reported as the average of members.
  # - All members must be the same `kind` (plug or bulb) — mixing is not
  #   supported.
  # - If any host fails to connect at startup, the whole fixture appears
  #   in /health.devices_failed.
  # - Per-host failures DURING runtime actions are logged but don't abort
  #   the fanout — the surviving member(s) still get the command.
  #
  # Uncomment and adjust:
  # - id: living-room-fixture
  #   name: Living Room Light
  #   driver: kasa
  #   params:
  #     host: [192.168.1.6, 192.168.1.7]
  #     kind: bulb

  # ---------------------------------------------------------------------
  # Kasa dimmable bulb (uncomment if you have one).
  # ---------------------------------------------------------------------
  # - id: kasa-bedroom-lamp
  #   name: Bedroom lamp
  #   driver: kasa
  #   params:
  #     host: 192.168.1.43
  #     kind: bulb

  # ---------------------------------------------------------------------
  # Spotify Connect endpoint (e.g. spotifyd / librespot running on the Pi).
  #
  # Required:
  #   client_id, client_secret  — from https://developer.spotify.com/dashboard
  #   redirect_uri              — must be registered with the Spotify app
  # Optional:
  #   target_device_name        — case-insensitive substring match of the
  #                               Connect device name; if omitted the first
  #                               available device is used.
  #
  # First-run OAuth note: the first time the driver authenticates it needs
  # interactive browser-based consent. Run the test script once on a desktop
  # with the same creds, then copy `.spotify_cache` to the Pi for headless
  # operation. See drivers/README.md.
  # ---------------------------------------------------------------------
  - id: spotify-pi
    name: Spotify on Pi
    driver: spotify
    params:
      client_id: REPLACE_WITH_SPOTIFY_CLIENT_ID
      client_secret: REPLACE_WITH_SPOTIFY_CLIENT_SECRET
      redirect_uri: http://127.0.0.1:8888/callback
      target_device_name: librespot
